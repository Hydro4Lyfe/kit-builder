	<Extensions xmlns="https://schneegans.de/windows/unattend-generator/">
		<ExtractScript>
# Bootstrap - the only script embedded in this answer file, because nothing is on C: yet.
#
# Finds the kit drive (the one with \Scripts\_scripts.marker), then copies Scripts\ to
# C:\Windows\Setup\Scripts\Custom along with settings.json and secrets.json. Everything
# after this runs from that copy, so later phases still work once the USB is pulled.

param(
    [xml] $Document
);

$setupRoot = 'C:\Windows\Setup\Scripts';
mkdir -Path $setupRoot -ErrorAction 'SilentlyContinue' | Out-Null;

&amp; {
    $targetRoot = Join-Path -Path $setupRoot -ChildPath 'Custom';

    $kitRoot = [System.IO.DriveInfo]::GetDrives() |
        Where-Object -FilterScript { $_.IsReady } |
        ForEach-Object -Process { $_.RootDirectory.FullName; } |
        Where-Object -FilterScript { Test-Path -LiteralPath ( Join-Path -Path $_ -ChildPath 'Scripts\_scripts.marker' ); } |
        Select-Object -First 1;

    if( -not $kitRoot ) {
        "WARNING: no kit drive found; looked for &lt;drive&gt;\Scripts\_scripts.marker on every ready drive.";
        return;
    }

    mkdir -Path $targetRoot -ErrorAction 'SilentlyContinue' | Out-Null;
    Copy-Item -Path ( Join-Path -Path $kitRoot -ChildPath 'Scripts\*' ) -Destination $targetRoot -Recurse -Force;

    # secrets.json gets a leading underscore so nothing mistakes it for a script;
    # FirstLogon.ps1 deletes it once setup is done.
    foreach( $pair in @( @( 'settings.json', 'settings.json' ), @( 'secrets.json', '_secrets.json' ) ) ) {
        $source = Join-Path -Path $kitRoot -ChildPath $pair[0];
        if( Test-Path -LiteralPath $source ) {
            Copy-Item -LiteralPath $source -Destination ( Join-Path -Path $targetRoot -ChildPath $pair[1] ) -Force;
        } else {
            "WARNING: {0} not found on the kit drive." -f $pair[0];
        }
    }

    # reg.exe wants UTF-16LE, so authors can keep editing the .reg files as plain text.
    $unicode = [System.Text.UnicodeEncoding]::new( $false, $true );
    foreach( $reg in Get-ChildItem -LiteralPath $targetRoot -Filter '*.reg' -Recurse -File ) {
        $content = Get-Content -LiteralPath $reg.FullName -Raw;
        [System.IO.File]::WriteAllBytes( $reg.FullName, $unicode.GetPreamble() + $unicode.GetBytes( $content ) );
    }

    "Copied the kit from '$kitRoot' to '$targetRoot'.";
} *&gt;&amp;1 | Out-String -Stream &gt;&gt; ( Join-Path -Path $setupRoot -ChildPath 'Bootstrap.log' );
		</ExtractScript>
	</Extensions>
</unattend>
