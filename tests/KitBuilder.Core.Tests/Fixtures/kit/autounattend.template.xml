					<Order>1</Order>
					<CommandLine>powershell.exe -WindowStyle Normal -NoProfile -Command "Get-Content -LiteralPath 'C:\Windows\Setup\Scripts\Custom\_system\FirstLogon.ps1' -Raw | Invoke-Expression;"</CommandLine>
