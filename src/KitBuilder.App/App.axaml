<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="KitBuilder.App.App"
             xmlns:local="using:KitBuilder.App"
             RequestedThemeVariant="Dark">
    <!-- Same fixed dark PT palette and control styles as PT Script Builder (src/ScriptGen.App/App.axaml),
         so the two tools look like one family. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <SolidColorBrush x:Key="PtWindowBg" Color="#16181d"/>
        <SolidColorBrush x:Key="PtBarBg" Color="#1d212a"/>
        <SolidColorBrush x:Key="PtBarBorder" Color="#262b34"/>
        <SolidColorBrush x:Key="PtSideBorder" Color="#232833"/>
        <SolidColorBrush x:Key="PtFieldBg" Color="#14161c"/>
        <SolidColorBrush x:Key="PtFieldBorder" Color="#2a2f3a"/>
        <SolidColorBrush x:Key="PtCardBg" Color="#1b1e25"/>
        <SolidColorBrush x:Key="PtCardBorder" Color="#262b34"/>
        <SolidColorBrush x:Key="PtBtnBg" Color="#232732"/>
        <SolidColorBrush x:Key="PtBtnBgHover" Color="#2a2f3c"/>
        <SolidColorBrush x:Key="PtBtnBorder" Color="#2f3440"/>
        <SolidColorBrush x:Key="PtAccent" Color="#4c8fdd"/>
        <SolidColorBrush x:Key="PtAccentHover" Color="#5c9be3"/>
        <SolidColorBrush x:Key="PtText" Color="#dde2ea"/>
        <SolidColorBrush x:Key="PtTextDim" Color="#9aa2b1"/>
        <SolidColorBrush x:Key="PtTextMuted" Color="#8b93a3"/>
        <SolidColorBrush x:Key="PtTextFaint" Color="#5b6373"/>
        <SolidColorBrush x:Key="PtGreen" Color="#58b47c"/>
        <SolidColorBrush x:Key="PtAmber" Color="#d9a854"/>
        <SolidColorBrush x:Key="PtRed" Color="#d97066"/>
        <SolidColorBrush x:Key="PtRedHoverBg" Color="#2b2226"/>
        <SolidColorBrush x:Key="PtSwitchOff" Color="#3a4150"/>
        <FontFamily x:Key="PtMono">Cascadia Code,Consolas,Menlo,monospace</FontFamily>

        <!-- Small iOS-style switch (30x17, 13px knob), as in PT Script Builder. -->
        <ControlTheme x:Key="PtSwitch" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Track" Width="30" Height="17" CornerRadius="9"
                            Background="{DynamicResource PtSwitchOff}">
                        <Border Name="Knob" Width="13" Height="13" CornerRadius="7"
                                Background="White" HorizontalAlignment="Left" Margin="2,0"/>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:checked /template/ Border#Track">
                <Setter Property="Background" Value="{DynamicResource PtAccent}"/>
            </Style>
            <Style Selector="^:checked /template/ Border#Knob">
                <Setter Property="HorizontalAlignment" Value="Right"/>
            </Style>
            <Style Selector="^:disabled /template/ Border#Track">
                <Setter Property="Opacity" Value="0.35"/>
            </Style>
        </ControlTheme>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource PtWindowBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource PtText}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style Selector="Button">
            <Setter Property="Background" Value="{DynamicResource PtBtnBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource PtText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PtBtnBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="11,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PtBtnBgHover}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PtBtnBorder}"/>
            <Setter Property="Foreground" Value="{DynamicResource PtText}"/>
        </Style>
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="{DynamicResource PtAccent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PtAccentHover}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource PtTextMuted}"/>
        </Style>
        <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PtSideBorder}"/>
            <Setter Property="Foreground" Value="{DynamicResource PtText}"/>
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource PtRed}"/>
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PtRedHoverBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource PtRed}"/>
        </Style>

        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource PtFieldBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource PtText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PtFieldBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource PtAccent}"/>
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource PtFieldBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PtFieldBorder}"/>
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource PtFieldBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PtAccent}"/>
        </Style>
        <Style Selector="TextBox.mono">
            <Setter Property="FontFamily" Value="{DynamicResource PtMono}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="AutoCompleteBox">
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{DynamicResource PtFieldBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource PtText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PtFieldBorder}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
        <Style Selector="CheckBox, RadioButton">
            <Setter Property="FontSize" Value="12.5"/>
        </Style>

        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
        </Style>

        <!-- Section label: WI-FI / ADMINISTRATOR / ... -->
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PtTextMuted}"/>
            <Setter Property="Margin" Value="0,4,0,2"/>
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource PtTextDim}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource PtTextFaint}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.error">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource PtRed}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.warning">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource PtAmber}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.ok">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource PtGreen}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- A grouped block of fields. -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource PtCardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PtCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
        </Style>
    </Application.Styles>
</Application>
