<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KitBuilder.App.ViewModels"
             x:Class="KitBuilder.App.Views.RemovalListView"
             x:DataType="vm:RemovalListViewModel">
    <StackPanel Spacing="8">
        <Grid ColumnDefinitions="260,12,*,Auto,6,Auto">
            <TextBox Text="{Binding Filter}" Watermark="Search, e.g. xbox"/>
            <TextBlock Grid.Column="2" Text="{Binding Summary}" Classes="label"/>
            <Button Grid.Column="3" Content="Tick all shown" Classes="ghost" Command="{Binding TickAllCommand}"/>
            <Button Grid.Column="5" Content="Untick all shown" Classes="ghost" Command="{Binding UntickAllCommand}"/>
        </Grid>

        <Border BorderBrush="{DynamicResource PtFieldBorder}" BorderThickness="1" CornerRadius="6"
                Background="{DynamicResource PtFieldBg}">
            <ScrollViewer MaxHeight="330">
                <ItemsControl ItemsSource="{Binding Visible}" Margin="6">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:RemovalItemViewModel">
                            <CheckBox IsChecked="{Binding IsRemoved}" Width="270" Margin="2,1" VerticalContentAlignment="Top"
                                      ToolTip.Tip="{Binding Id}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Detail}" Classes="hint" FontSize="10.5" TextTrimming="CharacterEllipsis"
                                               IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Grid ColumnDefinitions="Auto,8,320,8,Auto">
            <TextBlock Text="Not listed?" Classes="label"/>
            <TextBox Grid.Column="2" Text="{Binding NewId}" Classes="mono" Watermark="Exact name, e.g. Microsoft.BingFinance"/>
            <Button Grid.Column="4" Content="Add and tick" Command="{Binding AddCommand}"/>
        </Grid>
    </StackPanel>
</UserControl>
