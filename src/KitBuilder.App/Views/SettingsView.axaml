<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KitBuilder.App.ViewModels"
             x:Class="KitBuilder.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <UserControl.Styles>
        <!-- Row spacing for the label/field grids (Grid.RowSpacing needs Avalonia 11.3). -->
        <Style Selector="Grid.form > :is(Control)">
            <Setter Property="Margin" Value="0,3"/>
        </Style>
    </UserControl.Styles>

    <DockPanel>
        <!-- Save bar -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource PtBarBg}"
                BorderBrush="{DynamicResource PtBarBorder}" BorderThickness="0,1,0,0" Padding="12,8">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Unsaved changes" Classes="warning" IsVisible="{Binding IsDirty}"/>
                    <TextBlock Text="{Binding Message}" Classes="ok" IsVisible="{Binding !MessageIsError}"/>
                    <TextBlock Text="{Binding Message}" Classes="error" IsVisible="{Binding MessageIsError}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Reload from disk" Classes="ghost" Margin="0,0,8,0"
                        Command="{Binding ReloadCommand}"/>
                <Button Grid.Column="2" Content="Save settings" Classes="accent" Command="{Binding SaveCommand}"/>
            </Grid>
        </Border>

        <ScrollViewer>
            <StackPanel Margin="8,12" Spacing="14" MaxWidth="900" HorizontalAlignment="Left">

                <Border Classes="card">
                    <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto" Classes="form">
                        <TextBlock Grid.ColumnSpan="2" Text="WINDOWS" Classes="section"/>
                        <TextBlock Grid.Row="1" Text="Edition" Classes="label"/>
                        <AutoCompleteBox Grid.Row="1" Grid.Column="1" Text="{Binding Edition}" Width="320"
                                         HorizontalAlignment="Left" ItemsSource="{Binding Editions}" FilterMode="Contains"
                                         MinimumPrefixLength="0"/>
                        <TextBlock Grid.Row="2" Text="Time zone" Classes="label"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4">
                            <AutoCompleteBox Text="{Binding TimeZone}" Width="320" HorizontalAlignment="Left"
                                             ItemsSource="{Binding TimeZones}" FilterMode="Contains"/>
                            <TextBlock Classes="warning" IsVisible="{Binding TimeZoneUnknown}"
                                       Text="Windows does not recognise this time zone name. Start typing and pick one from the list, e.g. Mountain Standard Time."/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Classes="card">
                    <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto" Classes="form">
                        <TextBlock Grid.ColumnSpan="2" Text="ADMINISTRATOR AND PASSWORDS" Classes="section"/>
                        <TextBlock Grid.Row="1" Text="Admin password" Classes="label"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding AdminPassword}" Width="320"
                                 HorizontalAlignment="Left" PasswordChar="{Binding PasswordChar}"/>
                        <CheckBox Grid.Row="2" Grid.Column="1" Content="Show passwords" IsChecked="{Binding RevealPasswords}"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Classes="hint"
                                   Text="Passwords are kept in secrets.json, which is not in git. They are deleted from each machine at the end of setup."/>
                    </Grid>
                </Border>

                <Border Classes="card">
                    <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" Classes="form">
                        <TextBlock Grid.ColumnSpan="2" Text="WI-FI DURING SETUP" Classes="section"/>
                        <CheckBox Grid.Row="1" Grid.Column="1" Content="Connect to Wi-Fi during setup (for app installs)"
                                  IsChecked="{Binding WifiEnabled}"/>
                        <TextBlock Grid.Row="2" Text="Network name" Classes="label"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding WifiSsid}" Width="320"
                                 HorizontalAlignment="Left" IsEnabled="{Binding WifiEnabled}"/>
                        <TextBlock Grid.Row="3" Text="Password" Classes="label"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding WifiPassword}" Width="320"
                                 HorizontalAlignment="Left" PasswordChar="{Binding PasswordChar}" IsEnabled="{Binding WifiEnabled}"/>
                        <TextBlock Grid.Row="4" Text="Security" Classes="label"/>
                        <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding WifiAuthentications}"
                                  SelectedItem="{Binding WifiAuthentication}" Width="160" IsEnabled="{Binding WifiEnabled}"/>
                        <CheckBox Grid.Row="5" Grid.Column="1" Content="Hidden network (does not broadcast its name)"
                                  IsChecked="{Binding WifiHidden}" IsEnabled="{Binding WifiEnabled}"/>
                    </Grid>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <TextBlock Text="BUILT-IN APPS TO REMOVE" Classes="section"/>
                        <TextBlock Classes="hint"
                                   Text="Apps that come with Windows. Ticked apps are removed from every computer during setup; untick one to keep it."/>
                        <ContentControl Content="{Binding RemoveApps}"/>
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock Text="START MENU PINS" Classes="section"/>
                                <TextBlock Classes="hint" Text="Apps pinned to the Start menu for every user, in this order. A shortcut is the path of a .lnk file; a Store app is its app ID."/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Add pin" VerticalAlignment="Top" Command="{Binding AddPinCommand}"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Pins}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PinRowViewModel">
                                    <Grid ColumnDefinitions="160,8,*,8,Auto" Margin="0,3">
                                        <ComboBox ItemsSource="{Binding KindLabels}" SelectedItem="{Binding KindLabel}"
                                                  HorizontalAlignment="Stretch"/>
                                        <TextBox Grid.Column="2" Text="{Binding Value}" Classes="mono" Watermark="{Binding ValueHint}"/>
                                        <Button Grid.Column="4" Content="Remove" Classes="danger" Command="{Binding RemoveCommand}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Expander Header="Advanced: language codes and Windows extras" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="14" Margin="0,6,0,0">
                        <TextBlock Classes="hint" FontSize="12"
                                   Text="Rarely changed. Wrong values here can stop setup or remove things people need."/>
                        <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" Classes="form">
                            <TextBlock Grid.ColumnSpan="2" Text="LANGUAGE" Classes="section"/>
                            <TextBlock Grid.Row="1" Text="Windows display" Classes="label"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding UiLanguage}" Width="160" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Row="2" Text="Keyboard" Classes="label"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding InputLocale}" Width="160" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Row="3" Text="System locale" Classes="label"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SystemLocale}" Width="160" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Row="4" Text="Date and number formats" Classes="label"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding UserLocale}" Width="160" HorizontalAlignment="Left"/>
                        </Grid>
                        <TextBlock Classes="hint" Text="US English is en-US, with keyboard 0409:00000409."/>

                        <StackPanel Spacing="6">
                            <TextBlock Text="WINDOWS EXTRAS TO REMOVE" Classes="section"/>
                            <TextBlock Classes="hint"
                                       Text="Parts of Windows removed during setup. Windows keeps these in two lists, capabilities and optional features. Ticked items are removed."/>
                            <TextBlock Text="Capabilities" Classes="label"/>
                            <ContentControl Content="{Binding RemoveCapabilities}"/>
                            <TextBlock Text="Optional features" Classes="label" Margin="0,8,0,0"/>
                            <ContentControl Content="{Binding RemoveFeatures}"/>
                        </StackPanel>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
